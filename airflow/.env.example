# Copy to airflow/.env (gitignored). Read twice by docker compose:
#   --env-file airflow/.env   -> ${VAR} interpolation inside docker-compose.yml
#   env_file: .env            -> every key injected into the Airflow containers
# Mirrors the root .env.example but with CONTAINER paths. Paths marked (fixed) are
# overridden in docker-compose.yml anyway; keep them here for readability.
# ---------------------------------------------------------------- docker / airflow
AIRFLOW_UID=50000                  # `id -u` on Linux hosts; 50000 is fine on macOS
AIRFLOW__CORE__FERNET_KEY=         # optional: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__WEBSERVER__SECRET_KEY=    # any random string; same value for webserver + scheduler
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=        # admin UI password; set before first `make airflow-up`
_AIRFLOW_WWW_USER_EMAIL=admin@example.com
COSMOS_LOAD_METHOD=dbt_ls          # dbt_ls (default) | dbt_manifest | custom  (see dags/common.py)
# AIRFLOW__SMTP__SMTP_HOST=
# AIRFLOW__SMTP__SMTP_PORT=587
# AIRFLOW__SMTP__SMTP_USER=
# AIRFLOW__SMTP__SMTP_PASSWORD=
# AIRFLOW__SMTP__SMTP_MAIL_FROM=
# ---------------------------------------------------------------- general
CL_DATA_DIR=/opt/airflow/data      # (fixed) landing zone, bind mount of ../data
CL_SINKS=bigquery,databricks       # comma list; drop one to run single-warehouse
CL_OUR_COMPANY=ALLY FINANCIAL INC. # the "our bank" row the benchmark mart highlights (CFPB spelling)
CL_CFPB_OVERLAP_DAYS=60            # trailing window re-pulled every run (complaint rows mutate)
CL_FRED_SERIES=DGS10,DFF,DPRIME,MORTGAGE30US,TERMCBCCALLNS
CL_FRED_OVERLAP_DAYS=90            # FRED revises recent observations
# ---------------------------------------------------------------- BigQuery (sandbox, no billing)
GOOGLE_APPLICATION_CREDENTIALS=/opt/airflow/secrets/bq-service-account.json   # (fixed) ../secrets mounted read-only
CL_BQ_PROJECT=your-gcp-project-id
CL_BQ_LOCATION=US
CL_BQ_DATASET_PREFIX=conductlens   # datasets: conductlens_raw, conductlens_staging, conductlens_marts
CL_BQ_CFPB_GRAIN=daily_cells       # daily_cells (sandbox-safe) | complaints (needs billing)
# ---------------------------------------------------------------- Databricks (Free Edition)
DATABRICKS_HOST=https://dbc-xxxxxxxx-xxxx.cloud.databricks.com
DATABRICKS_TOKEN=                  # personal access token (never commit; never echo)
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/xxxxxxxxxxxxxxxx
CL_DBX_CATALOG=workspace
CL_DBX_SCHEMA_PREFIX=conductlens   # schemas: conductlens_raw, conductlens_staging, conductlens_marts, conductlens_snapshots
CL_DBX_VOLUME=landing              # UC managed volume inside conductlens_raw used as the COPY/MERGE staging area
# ---------------------------------------------------------------- dbt
DBT_PROFILES_DIR=/opt/airflow/dbt  # (fixed) bind mount of ../dbt
DBT_TARGET=dbx                     # dbx | bq  (Cosmos sets the target per task group explicitly)
